#!/bin/sh
# Enable with: git config core.hooksPath .githooks
# Runs the CI checks before each commit; swift test only when Swift files are staged.
set -e
cd "$(git rev-parse --show-toplevel)"

uv run ruff format --check bsafe/ tests/ || {
    echo "pre-commit: run 'uv run ruff format bsafe/ tests/' and re-stage" >&2
    exit 1
}
uv run ruff check bsafe/ tests/
uv run pytest -q

if git diff --cached --name-only | grep -q '^swift/'; then
    (cd swift && swift test)
fi
